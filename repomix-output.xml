  Future<void> _updateAddressFromCoordinates(double lat, double lon) async {
    try {
      final placemarks = await placemarkFromCoordinates(lat, lon);
      if (placemarks.isNotEmpty) {
        final place = placemarks.first;
        final subLocality = place.subLocality?.trim() ?? '';
        final locality = place.locality?.trim() ?? '';

        String name = '';
        if (subLocality.isNotEmpty && locality.isNotEmpty && subLocality != locality) {
          name = '$subLocality, $locality';
        } else if (locality.isNotEmpty) {
          name = locality;
        } else if (place.name?.isNotEmpty == true) {
          name = place.name!;
        } else {
          name = 'Current Location';
        }

        if (mounted) {
          setState(() {
            _currentAddress = name;
            _locationStatus = name;
          });
        }
      }
    } catch (e) {
      debugPrint('[Geocoding Error] $e');
      if (mounted) {
        setState(() {
          _currentAddress = 'Current Location';
        });
      }
    }
  }

  void _onLocationUpdate(double newLat, double newLon) {
    if (_isLoading) return;

    if (_lastKnownLat != null && _lastKnownLon != null) {
      final latDelta = (newLat - _lastKnownLat!).abs();
      final lonDelta = (newLon - _lastKnownLon!).abs();
      if (latDelta < 0.001 && lonDelta < 0.001) {
        return; // Ignore micro-jitter
      }
    }

    debugPrint('[Location Drift Detected] delta >= 0.001');
    _lastKnownLat = newLat;
    _lastKnownLon = newLon;
    if (mounted) {
      setState(() {
        _latitude = newLat;
        _longitude = newLon;
        _isGpsActive = true;
      });
    } else {
      _latitude = newLat;
      _longitude = newLon;
    }
    _verifyServiceabilityLocationMatch();
    _updateAddressFromCoordinates(newLat, newLon);
    _injectLocationIntoInstamart();
    _injectLocationIntoZepto(newLat, newLon);

    // Only trigger _searchGroceries if _searchController.text.trim().isNotEmpty and query has not already been fetched for these coordinates
    final activeQuery = _searchController.text.trim();
    final currentKey = '$activeQuery-${newLat.toStringAsFixed(3)}-${newLon.toStringAsFixed(3)}';
    if (activeQuery.isNotEmpty && currentKey != _lastFetchedKey) {
      _lastFetchedKey = currentKey;
      _searchGroceries(activeQuery);
    }
  }

  Future<void> _fetchCurrentLocation() async {
    if (mounted) {
      setState(() {
        _locationStatus = 'Locating...';
        _currentAddress = 'Detecting Location...';
      });
    }
    try {
      bool serviceEnabled = await Geolocator.isLocationServiceEnabled();
      if (!serviceEnabled) {
        if (mounted) {
          setState(() {
            _locationStatus = 'Location Disabled';
            _currentAddress = 'Enable Location';
            _errorMessage = 'Location permission required to check dark-store availability';
            _isGpsActive = false;
          });
        }
        return;
      }

      LocationPermission permission = await Geolocator.checkPermission();
      if (permission == LocationPermission.denied) {
        permission = await Geolocator.requestPermission();
        if (permission == LocationPermission.denied) {
          if (mounted) {
            setState(() {
              _locationStatus = 'Permission Denied';
              _currentAddress = 'Location Permission Required';
              _errorMessage = 'Location permission required to check dark-store availability';
              _isGpsActive = false;
            });
          }
          return;
        }
      }

      if (permission == LocationPermission.deniedForever) {
        if (mounted) {
          setState(() {
            _locationStatus = 'Permission Permanently Denied';
            _currentAddress = 'Location Permission Required';
            _errorMessage = 'Location permission required to check dark-store availability';
            _isGpsActive = false;
          });
        }
        return;
      }

      Position position = await Geolocator.getCurrentPosition(
        desiredAccuracy: LocationAccuracy.high,
      );

      if (mounted) {
        setState(() {
          _latitude = position.latitude;
          _longitude = position.longitude;
          _isGpsActive = true;
          _errorMessage = null;
        });
      } else {
        _latitude = position.latitude;
        _longitude = position.longitude;
      }
      _verifyServiceabilityLocationMatch();

      _onLocationUpdate(position.latitude, position.longitude);
    } catch (e) {
      debugPrint('[GPS Fetch Error] $e');
      if (mounted) {
        setState(() {
          _locationStatus = 'Location Unavailable';
          _currentAddress = 'Location Unavailable';
          _errorMessage = 'Location permission required to check dark-store availability';
          _isGpsActive = false;
        });
      }
    }
  }


  Future<void> _searchGroceries(String query) async {
    if (query.isEmpty) return;

    if (_latitude == null || _longitude == null) {
      await _fetchCurrentLocation();
      if (_latitude == null || _longitude == null) {
        if (mounted) {
          setState(() {
            _isLoading = false;
            _errorMessage = 'Location permission required to check dark-store availability';
          });
        }
        return;
      }
    }

    final latVal = _latitude!;
    final lonVal = _longitude!;
    _lastFetchedKey = '$query-${latVal.toStringAsFixed(3)}-${lonVal.toStringAsFixed(3)}';

    setState(() {
      _isLoading = true;
      _errorMessage = null;
    });

    try {
      final zeptoProducts = await _fetchZeptoClientSide(query, latVal, lonVal);

      final url = '$_serverBaseUrl/api/compare';
      final headers = {
        'Accept': 'application/json',
        'Content-Type': 'application/json',
        'X-Location-Lat': '$latVal',
        'X-Location-Lng': '$lonVal',
      };
      final body = json.encode({
        'query': query,
        'latitude': latVal,
        'longitude': lonVal,
        'zepto_products': zeptoProducts,
      });

      http.Response response;
      try {
        response = await http
            .post(Uri.parse(url), headers: headers, body: body)
            .timeout(const Duration(seconds: 40));
      } catch (postErr) {
        if (_serverBaseUrl.contains('127.0.0.1')) {
          final altUrl = url.replaceAll('127.0.0.1', '192.168.1.10');
          response = await http
              .post(Uri.parse(altUrl), headers: headers, body: body)
              .timeout(const Duration(seconds: 40));
        } else {
          rethrow;
        }
      }
      if (response.statusCode == 200) {
        final data = json.decode(response.body) as Map<String, dynamic>;

        final List<dynamic> rawCanonical = data['canonical_cards'] as List<dynamic>? ?? [];
        final parsedCanonical = rawCanonical.map((e) => CanonicalCard.fromJson(e as Map<String, dynamic>)).toList();

        final List<dynamic> rawList = data['results'] as List<dynamic>? ?? [];
        final parsedResults = rawList.map((e) => ProductComparisonItem.fromJson(e as Map<String, dynamic>)).toList();

        final rawBlinkitCount = (data['raw_blinkit_count'] as num?)?.toInt() ?? 0;
        final rawZeptoCount = (data['raw_zepto_count'] as num?)?.toInt() ?? 0;
        final rawInstamartCount = (data['raw_instamart_count'] as num?)?.toInt() ?? 0;
        final isZeptoBlocked = data['zepto_blocked'] == true;

        // Verification rules:
        // 1. server_received_zepto_products must ONLY be true when proved by backend response
        final bool serverReceivedZeptoProducts =
    data['server_received_zepto_products'] == true &&
    rawZeptoCount > 0;

final bool realProductData =
    zeptoProducts.isNotEmpty &&
    zeptoProducts.every(
      (p) =>
          (p['name']?.toString().trim().isNotEmpty ?? false) &&
          ((p['price'] as num?)?.toDouble() ?? 0.0) > 0.0 &&
          (p['id']?.toString().trim().isNotEmpty ?? false) &&
          (p['packsize']?.toString().trim().isNotEmpty ?? false),
    );

final bool serviceabilityEstablished =
    _isLocationBoundServiceabilityReady;

final bool comparisonCompleted =
    parsedResults.isNotEmpty ||
    parsedCanonical.isNotEmpty;

final String status =
    (
      serverReceivedZeptoProducts &&
      realProductData &&
      comparisonCompleted &&
      serviceabilityEstablished &&
      _locationRequestMatchesNative
    )
        ? "PASS"
        : (isZeptoBlocked
            ? "BLOCKED/UNAVAILABLE"
            : "FAIL");

      
        debugPrint('[ZEPTO PRODUCTION TEST]');
        debugPrint('zepto_source=zepto_webview');
        debugPrint('serviceability_request_found=$_serviceabilityRequestSeen');
        debugPrint('coordinates_found_in_request=${_serviceabilityReqLat != null && _serviceabilityReqLon != null}');
        debugPrint('serviceability_response_paired=${_serviceabilityRequestSeen && _zeptoStoreIdPresent}');
        debugPrint('webview_ready=$_isZeptoReady');
        debugPrint('browser_geolocation_success=$_browserGeolocationSuccess');
        debugPrint('serviceability_request_seen=$_serviceabilityRequestSeen');
        debugPrint('serviceable=$_isZeptoServiceable');
        debugPrint('store_id_present=$_zeptoStoreIdPresent');
        debugPrint('location_request_matches_native=$_locationRequestMatchesNative');
        debugPrint('serviceability_established=$serviceabilityEstablished');
        debugPrint('search_started=true');
        debugPrint('zepto_product_count=${zeptoProducts.length}');
        debugPrint('real_product_data=$realProductData');
        debugPrint('server_received_zepto_products=$serverReceivedZeptoProducts');
        debugPrint('blinkit_product_count=$rawBlinkitCount');
        debugPrint('comparison_completed=$comparisonCompleted');
        debugPrint('fallback_store_used=false');
        debugPrint('fake_data_used=false');
        if (zeptoProducts.isNotEmpty) {
          for (var p in zeptoProducts) {
            debugPrint('[Zepto Product Item] ${p["name"]} => ₹${p["price"]} (pack: ${p["packsize"]})');
          }
          debugPrint('first_product_name=${zeptoProducts.first["name"]}');
          debugPrint('first_product_price=${zeptoProducts.first["price"]}');
        } else {
          debugPrint('first_product_name=none');
          debugPrint('first_product_price=none');
        }
        debugPrint('status=$status');

        if (mounted) {
          setState(() {
            _canonicalCards = parsedCanonical;
            _results = parsedResults;
            _rawBlinkitCount = rawBlinkitCount;
            _rawZeptoCount = rawZeptoCount;
            _rawInstamartCount = rawInstamartCount;
            _isLoading = false;
          });
          SearchStateController().saveSearch(
            query: query,
            cards: parsedCanonical,
            items: parsedResults,
            blinkitCount: rawBlinkitCount,
            zeptoCount: rawZeptoCount,
            instamartCount: rawInstamartCount,
            lat: latVal,
            lon: lonVal,
            address: _currentAddress,
            navIndex: _bottomNavIndex,
          );
        }
        return;
      } else {
        if (mounted) {
          setState(() {
            _errorMessage = 'Server error: ${response.statusCode} from $_serverBaseUrl';
            _isLoading = false;
          });
        }
      }
    } catch (e) {
      debugPrint('[Compare Fetch Error] $e');
      if (mounted) {
        setState(() {
          _errorMessage = 'Cannot connect to $_serverBaseUrl.\nMake sure PC and phone are on the same Wi-Fi.';
          _isLoading = false;
        });
      }
    }
  }

 

  Future<void> _openInstamart(String productName, String fallbackUrl) async {
    final cleanQuery = productName
        .replaceAll(RegExp(r'\([^)]*\)'), '')
        .replaceAll(RegExp(r'\|.*'), '')
        .replaceAll(RegExp(r'\s+'), ' ')
        .trim();

    try {
      await Clipboard.setData(ClipboardData(text: cleanQuery));
    } catch (_) {}

    final encoded = Uri.encodeComponent(cleanQuery);
    final intentUrl = Uri.parse('https://www.swiggy.com/instamart/search?custom_back=true&query=$encoded');
    try {
      final launched = await launchUrl(intentUrl, mode: LaunchMode.externalApplication);
      if (launched) return;
    } catch (_) {}

    try {
      final nativeUri = Uri.parse('swiggy://instamart/search?query=$encoded');
      final launched = await launchUrl(nativeUri, mode: LaunchMode.externalApplication);
      if (launched) return;
    } catch (_) {}

    try {
      final fallback = Uri.parse('swiggy://instamart');
      await launchUrl(fallback, mode: LaunchMode.externalApplication);
      return;
    } catch (_) {}

    if (fallbackUrl.isNotEmpty) {
      _openBuyLink(fallbackUrl);
    }
  }

