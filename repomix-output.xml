class CanonicalComparisonCard extends StatefulWidget {
  final CanonicalCard card;
  final void Function(String url) onBuy;

  const CanonicalComparisonCard({
    super.key,
    required this.card,
    required this.onBuy,
  });

  @override
  State<CanonicalComparisonCard> createState() => _CanonicalComparisonCardState();
}

class _CanonicalComparisonCardState extends State<CanonicalComparisonCard> {
  StoreItem? _selectedBlinkit;
  StoreItem? _selectedZepto;

  @override
  void initState() {
    super.initState();
    _selectedBlinkit = widget.card.blinkit;
    _selectedZepto = widget.card.zepto;
  }

  @override
  void didUpdateWidget(covariant CanonicalComparisonCard oldWidget) {
    super.didUpdateWidget(oldWidget);
    if (oldWidget.card.id != widget.card.id) {
      _selectedBlinkit = widget.card.blinkit;
      _selectedZepto = widget.card.zepto;
    }
  }

  @override
  Widget build(BuildContext context) {
    final bItem = _selectedBlinkit;
    final zItem = _selectedZepto;
    final bAvailable = bItem != null && bItem.isAvailable && bItem.price > 0;
    final zAvailable = zItem != null && zItem.isAvailable && zItem.price > 0;
    final hasBoth = bAvailable && zAvailable;

    final double bPrice = bItem?.price ?? 0.0;
    final double zPrice = zItem?.price ?? 0.0;
    double savings = 0.0;
    String cheapestStore = '';
    int priceDeltaPct = 0;

    if (hasBoth) {
      final maxP = bPrice > zPrice ? bPrice : zPrice;
      final minP = bPrice < zPrice ? bPrice : zPrice;
      savings = maxP - minP;
      if (maxP > 0 && savings > 0) {
        priceDeltaPct = ((savings / maxP) * 100).round();
      }
      if (bPrice < zPrice) {
        cheapestStore = 'Blinkit';
      } else if (zPrice < bPrice) {
        cheapestStore = 'Zepto';
      }
    } else {
      savings = widget.card.savings;
      cheapestStore = widget.card.cheapestStore;
    }

    // Unit price details
    final upc = widget.card.unitPriceComparison;
    final double bStdPrice = (bItem != null && bItem.standardUnitPrice > 0)
        ? bItem.standardUnitPrice
        : (upc?.blinkitStandardUnitPrice ?? 0.0);
    final double zStdPrice = (zItem != null && zItem.standardUnitPrice > 0)
        ? zItem.standardUnitPrice
        : (upc?.zeptoStandardUnitPrice ?? 0.0);

    final String stdUnit = (bItem?.standardUnit.isNotEmpty == true ? bItem!.standardUnit : null) ??
        (zItem?.standardUnit.isNotEmpty == true ? zItem!.standardUnit : null) ??
        upc?.standardUnit ??
        '';

    final bool hasBothUnitPrices = bAvailable && zAvailable && bStdPrice > 0 && zStdPrice > 0;
    final bool isBlinkitCheaperUnit = hasBothUnitPrices && bStdPrice < zStdPrice;
    final bool isZeptoCheaperUnit = hasBothUnitPrices && zStdPrice < bStdPrice;
    final int unitPriceDeltaPct = hasBothUnitPrices
        ? (((bStdPrice - zStdPrice).abs() / (bStdPrice > zStdPrice ? bStdPrice : zStdPrice)) * 100).round()
        : 0;

    final allVariants = <StoreItem>[
      if (widget.card.blinkit != null) widget.card.blinkit!,
      ...widget.card.blinkitVariants,
      if (widget.card.zepto != null) widget.card.zepto!,
      ...widget.card.zeptoVariants,
    ];

    final sizeSet = <String>{};
    for (final v in allVariants) {
      final p = v.packsize.trim();
      if (p.isNotEmpty) sizeSet.add(p);
    }
    final hasVariants =
        (widget.card.blinkitVariants.isNotEmpty || widget.card.zeptoVariants.isNotEmpty) && sizeSet.length > 1;

    return Container(
      decoration: BoxDecoration(
        color: const Color(0xFF141C27),
        borderRadius: BorderRadius.circular(16),
        border: Border.all(
          color: hasBoth && cheapestStore.isNotEmpty
              ? const Color(0xFF10B981).withValues(alpha: 0.25)
              : const Color(0xFF222D3D),
          width: 1.2,
        ),
        boxShadow: const [
          BoxShadow(
            color: Color(0x33000000),
            blurRadius: 10,
            offset: Offset(0, 4),
          ),
        ],
      ),
      padding: const EdgeInsets.all(14),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          // Row 1: Canonical Title & Packaging / Brand Meta Chips
          Row(
            crossAxisAlignment: CrossAxisAlignment.start,
            children: [
              Expanded(
                child: Column(
                  crossAxisAlignment: CrossAxisAlignment.start,
                  children: [
                    Text(
                      widget.card.canonicalName,
                      maxLines: 2,
                      overflow: TextOverflow.ellipsis,
                      style: const TextStyle(
                        fontWeight: FontWeight.bold,
                        fontSize: 15,
                        color: Colors.white,
                        height: 1.25,
                      ),
                    ),
                    if (widget.card.brand.isNotEmpty || widget.card.packaging.isNotEmpty) ...[
                      const SizedBox(height: 4),
                      Wrap(
                        spacing: 4.0,
                        runSpacing: 4.0,
                        crossAxisAlignment: WrapCrossAlignment.center,
                        children: [
                          if (widget.card.brand.isNotEmpty)
                            Container(
                              padding: const EdgeInsets.symmetric(horizontal: 6, vertical: 2),
                              decoration: BoxDecoration(
                                color: const Color(0xFF1E293B),
                                borderRadius: BorderRadius.circular(4),
                              ),
                              child: Text(
                                widget.card.brand.toUpperCase(),
                                style: const TextStyle(
                                  fontSize: 9.5,
