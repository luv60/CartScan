class StoreOffer {
  final String name;
  final String packsize;
  final double price;
  final double normalizedPrice;
  final String unit;
  final String formattedUnitPrice;
  final String buyUrl;
  final String imageUrl;
  final bool isAvailable;

  StoreOffer({
    required this.name,
    required this.packsize,
    required this.price,
    required this.normalizedPrice,
    required this.unit,
    required this.formattedUnitPrice,
    required this.buyUrl,
    this.imageUrl = '',
    this.isAvailable = true,
  });

  factory StoreOffer.fromJson(Map<String, dynamic> json) {
    return StoreOffer(
      name: json['name']?.toString() ?? '',
      packsize: json['packsize']?.toString() ?? '',
      price: (json['price'] as num?)?.toDouble() ?? 0.0,
      normalizedPrice: (json['normalized_price'] as num?)?.toDouble() ?? 0.0,
      unit: json['unit']?.toString() ?? '',
      formattedUnitPrice: json['formatted_unit_price']?.toString() ?? '',
      buyUrl: json['buy_url']?.toString() ?? '',
      imageUrl: json['image_url']?.toString() ?? '',
      isAvailable: json['is_available'] == null ? true : (json['is_available'] as bool? ?? true),
    );
  }
}

class ProductComparisonItem {
  final String name;
  final String packsize;
  final String unit;
  final int matchScore;
  final String cheaperStore;
  final StoreOffer? blinkit;
  final StoreOffer? zepto;
  final StoreOffer? instamart;

  String get imageUrl {
    if (blinkit?.imageUrl.isNotEmpty == true) return blinkit!.imageUrl;
    if (zepto?.imageUrl.isNotEmpty == true) return zepto!.imageUrl;
    if (instamart?.imageUrl.isNotEmpty == true) return instamart!.imageUrl;
    return '';
  }

  ProductComparisonItem({
    required this.name,
    required this.packsize,
    required this.unit,
    required this.matchScore,
    required this.cheaperStore,
    this.blinkit,
    this.zepto,
    this.instamart,
  });

  factory ProductComparisonItem.fromJson(Map<String, dynamic> json) {
    return ProductComparisonItem(
      name: json['name']?.toString() ?? '',
      packsize: json['packsize']?.toString() ?? '',
      unit: json['unit']?.toString() ?? '',
      matchScore: (json['match_score'] as num?)?.toInt() ?? 0,
      cheaperStore: json['cheaper_store']?.toString() ?? '',
      blinkit: json['blinkit'] != null ? StoreOffer.fromJson(json['blinkit']) : null,
      zepto: json['zepto'] != null ? StoreOffer.fromJson(json['zepto']) : null,
      instamart: json['instamart'] != null ? StoreOffer.fromJson(json['instamart']) : null,
    );
  }
}

class StoreItem {
  final String name;
  final double price;
  final String packsize;
  final double normalizedPrice;
  final double standardUnitPrice;
  final String standardUnit;
  final String unit;
  final String formattedUnitPrice;
  final String imageUrl;
  final String buyUrl;
  final String productId;
  final bool isAvailable;

  StoreItem({
    required this.name,
    required this.price,
    required this.packsize,
    required this.normalizedPrice,
    this.standardUnitPrice = 0.0,
    this.standardUnit = '',
    required this.unit,
    required this.formattedUnitPrice,
    required this.imageUrl,
    required this.buyUrl,
    this.productId = '',
    this.isAvailable = true,
  });

  factory StoreItem.fromJson(dynamic json) {
    if (json is! Map<String, dynamic>) {
      return StoreItem(
        name: '',
        price: 0.0,
        packsize: '',
        normalizedPrice: 0.0,
        standardUnitPrice: 0.0,
        standardUnit: '',
        unit: '',
        formattedUnitPrice: '',
        imageUrl: '',
        buyUrl: '',
        isAvailable: true,
      );
    }
    return StoreItem(
      name: json['name']?.toString() ?? json['raw_name']?.toString() ?? '',
      price: (json['price'] as num?)?.toDouble() ?? 0.0,
      packsize: json['packsize']?.toString() ?? json['unit']?.toString() ?? '',
      normalizedPrice: (json['normalized_price'] as num?)?.toDouble() ?? 0.0,
      standardUnitPrice: (json['standard_unit_price'] as num?)?.toDouble() ?? 0.0,
      standardUnit: json['standard_unit']?.toString() ?? '',
      unit: json['unit']?.toString() ?? '',
      formattedUnitPrice: json['formatted_unit_price']?.toString() ?? '',
      imageUrl: json['image_url']?.toString() ?? '',
      buyUrl: json['buy_url']?.toString() ?? '',
      productId: json['product_id']?.toString() ?? '',
      isAvailable: json['is_available'] == null ? true : (json['is_available'] as bool? ?? true),
    );
  }
}

