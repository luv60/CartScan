              status: response.status,
              storeId: storeId,
              pincode: pincode,
              serviceable: serviceable
            };

            window.__zeptoBootstrapResult =
                JSON.stringify(result);

            if (
              storeId &&
              String(storeId).trim().length > 0
            ) {
              try {
                localStorage.setItem(
                  'zepto_store_id',
                  String(storeId)
                );
              } catch (e) {}
            }

            if (
              pincode &&
              String(pincode).trim().length > 0
            ) {
              try {
                localStorage.setItem(
                  'pincode',
                  String(pincode)
                );
              } catch (e) {}
            }

            try {
              window.__nativeZeptoStoreContext = {
                storeId: storeId,
                pincode: pincode,
                serviceable: serviceable,
                latitude: lat,
                longitude: lon
              };
            } catch (e) {}
          }).catch(function(error) {
            window.__zeptoBootstrapResult =
                JSON.stringify({
                  done: true,
                  ok: false,
                  status: 0,
                  error: String(error)
                });
          });
        } catch (e) {
          window.__zeptoBootstrapResult =
              JSON.stringify({
                done: true,
                ok: false,
                status: 0,
                error: String(e)
              });
        }
      })();
    ''';

    await _zeptoWebViewController.runJavaScript(
      bootstrapScript,
    );

    // Poll the WebView for the asynchronous bootstrap result.
    for (int attempt = 0; attempt < 24; attempt++) {
      await Future.delayed(
        const Duration(milliseconds: 250),
      );

      try {
        final raw =
            await _zeptoWebViewController
                .runJavaScriptReturningResult(
          'JSON.stringify(window.__zeptoBootstrapResult || null);',
        );

        String jsonText = raw.toString();

        if (
          jsonText.startsWith('"') &&
          jsonText.endsWith('"')
        ) {
          try {
            jsonText = json.decode(jsonText);
          } catch (_) {}
        }

        if (
          jsonText.isEmpty ||
          jsonText == 'null' ||
          jsonText == '"null"'
        ) {
          continue;
        }

        final decoded =
            json.decode(jsonText);

        if (decoded is! Map) {
          continue;
        }

        final result =
            Map<String, dynamic>.from(decoded);

        if (result['done'] != true) {
          continue;
        }

        final bool requestOk =
            result['ok'] == true;

        final bool serviceable =
            result['serviceable'] == true;

        final storeId =
            result['storeId']
                ?.toString()
                .trim();

        final pincode =
            result['pincode']
                ?.toString()
                .trim();

        final bool hasStore =
            storeId != null &&
            storeId.isNotEmpty;

        _serviceabilityRequestSeen =
            requestOk;

        _serviceabilityAfterLocation =
            requestOk;

        _serviceabilityReqLat =
            useLat;

        _serviceabilityReqLon =
            useLon;

        _serviceabilityReqLatStr =
            useLat.toString();

        _serviceabilityReqLonStr =
            useLon.toString();

        _locationRequestMatchesNative =
            requestOk;

        _isZeptoServiceable =
            serviceable;

        _zeptoStoreIdPresent =
            hasStore;

        _zeptoStoreId =
            hasStore ? storeId : null;

        _zeptoPincode =
            (pincode != null && pincode.isNotEmpty)
                ? pincode
                : null;

        _zeptoBootstrapEstablished =
            requestOk &&
            serviceable &&
            hasStore;

        debugPrint(
          '[Zepto Bootstrap] '
          'request_ok=$requestOk, '
          'serviceable=$serviceable, '
          'store_id_present=$hasStore',
        );

        return;
      } catch (_) {}
    }

    debugPrint(
      '[Zepto Bootstrap] Timed out waiting for '
      'location/store context.',
    );
  } catch (e) {
    debugPrint(
      '[Zepto Bootstrap] Error: $e',
    );
  }
}

