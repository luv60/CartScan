                      border: isZeptoCheaperUnit
                          ? Border.all(color: const Color(0xFF10B981), width: 1)
                          : null,
                    ),
                    child: Text(
                      'Zepto: ₹${zStdPrice.toStringAsFixed(2)}',
                      style: TextStyle(
                        fontSize: 11,
                        fontWeight: isZeptoCheaperUnit ? FontWeight.w900 : FontWeight.w500,
                        color: isZeptoCheaperUnit ? const Color(0xFF34D399) : const Color(0xFFCBD5E1),
                      ),
                    ),
                  ),

                  if (unitPriceDeltaPct > 0)
                    Container(
                      padding: const EdgeInsets.symmetric(horizontal: 5, vertical: 1.5),
                      decoration: BoxDecoration(
                        color: const Color(0xFF10B981),
                        borderRadius: BorderRadius.circular(4),
                      ),
                      child: Text(
                        '-$unitPriceDeltaPct%',
                        style: const TextStyle(
                          fontSize: 9,
                          fontWeight: FontWeight.w900,
                          color: Colors.white,
                        ),
                      ),
                    ),
                ],
              ),
            ),
          ],

          const SizedBox(height: 12),

          // Row 3: Side-by-Side Body: 2 Expanded Columns (Blinkit vs Zepto)
          IntrinsicHeight(
            child: Row(
              crossAxisAlignment: CrossAxisAlignment.stretch,
              children: [
                // Blinkit Column
                Expanded(
                  child: _buildStoreColumn(
                    storeName: 'Blinkit',
                    brandColor: const Color(0xFFF7C948),
                    badgeTextColor: Colors.black,
                    item: bItem,
                    isCheapestPrice: cheapestStore == 'Blinkit' && hasBoth,
                    isCheapestUnit: isBlinkitCheaperUnit,
                    stdUnitPrice: bStdPrice,
                    stdUnit: stdUnit,
                  ),
                ),
                const SizedBox(width: 10),
                Container(
                  width: 1,
                  color: const Color(0xFF1E293B),
                ),
                const SizedBox(width: 10),
                // Zepto Column
                Expanded(
                  child: _buildStoreColumn(
                    storeName: 'Zepto',
                    brandColor: const Color(0xFF7952FC),
                    badgeTextColor: Colors.white,
                    item: zItem,
                    isCheapestPrice: cheapestStore == 'Zepto' && hasBoth,
                    isCheapestUnit: isZeptoCheaperUnit,
                    stdUnitPrice: zStdPrice,
                    stdUnit: stdUnit,
                  ),
                ),
              ],
            ),
          ),

          // Row 4: Variant Chips
          if (hasVariants) ...[
            const SizedBox(height: 12),
            const Divider(color: Color(0xFF1E293B), height: 1),
            const SizedBox(height: 8),
            const Row(
              children: [
                Icon(Icons.straighten_rounded, size: 12, color: Color(0xFF94A3B8)),
                SizedBox(width: 4),
                Text(
                  'Available Sizes / Packs:',
                  style: TextStyle(
                    fontSize: 10.5,
                    color: Color(0xFF94A3B8),
                    fontWeight: FontWeight.w600,
                  ),
                ),
              ],
            ),
            const SizedBox(height: 6),
            SingleChildScrollView(
              scrollDirection: Axis.horizontal,
              child: Row(
                children: sizeSet.map((size) {
                  final isCurrent =
                      (bItem?.packsize.trim() == size) || (zItem?.packsize.trim() == size);
                  return Padding(
                    padding: const EdgeInsets.only(right: 6),
                    child: InkWell(
                      onTap: () {
                        StoreItem? matchingB;
                        try {
                          matchingB = [
                            if (widget.card.blinkit != null) widget.card.blinkit!,
                            ...widget.card.blinkitVariants,
                          ].firstWhere((v) => v.packsize.trim() == size);
                        } catch (_) {
                          matchingB = null;
                        }

                        StoreItem? matchingZ;
                        try {
                          matchingZ = [
                            if (widget.card.zepto != null) widget.card.zepto!,
                            ...widget.card.zeptoVariants,
                          ].firstWhere((v) => v.packsize.trim() == size);
                        } catch (_) {
                          matchingZ = null;
                        }

                        setState(() {
                          _selectedBlinkit = matchingB ?? _selectedBlinkit;
                          _selectedZepto = matchingZ ?? _selectedZepto;
                        });
                      },
                      borderRadius: BorderRadius.circular(12),
                      child: Container(
                        padding: const EdgeInsets.symmetric(horizontal: 8, vertical: 3),
                        decoration: BoxDecoration(
                          color: isCurrent ? const Color(0xFF1E3A5F) : const Color(0xFF0F141C),
                          borderRadius: BorderRadius.circular(12),
                          border: Border.all(
                            color: isCurrent ? const Color(0xFF60A5FA) : const Color(0xFF243142),
                          ),
                        ),
                        child: Text(
                          size,
                          style: TextStyle(
                            fontSize: 10.5,
                            fontWeight: isCurrent ? FontWeight.bold : FontWeight.normal,
                            color: isCurrent ? const Color(0xFF93C5FD) : const Color(0xFF94A3B8),
                          ),
                        ),
                      ),
                    ),
                  );
                }).toList(),
              ),
            ),
          ],
        ],
      ),
    );
  }

  Widget _buildStoreColumn({
    required String storeName,
    required Color brandColor,
    required Color badgeTextColor,
    required StoreItem? item,
    required bool isCheapestPrice,
    required bool isCheapestUnit,
    required double stdUnitPrice,
    required String stdUnit,
  }) {
    final bool isAvailable = item != null && item.isAvailable && item.price > 0;

    return Container(
      padding: const EdgeInsets.all(8),
      decoration: BoxDecoration(
        color: const Color(0xFF0F141C),
        borderRadius: BorderRadius.circular(12),
        border: Border.all(
          color: isCheapestPrice
              ? const Color(0xFF10B981).withValues(alpha: 0.6)
              : const Color(0xFF1E293B),
          width: isCheapestPrice ? 1.5 : 1.0,
        ),
      ),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.center,
        children: [
          // Platform Header Strip: Brand Pill + Platform Availability Badge
          Wrap(
            alignment: WrapAlignment.spaceBetween,
            crossAxisAlignment: WrapCrossAlignment.center,
            spacing: 4.0,
            runSpacing: 4.0,
            children: [
              // Store Brand Pill
              Container(
                padding: const EdgeInsets.symmetric(horizontal: 6, vertical: 2),
                decoration: BoxDecoration(
                  color: brandColor,
                  borderRadius: BorderRadius.circular(5),
                ),
                child: Text(
                  storeName,
                  style: TextStyle(
                    fontSize: 9.5,
                    fontWeight: FontWeight.bold,
                    color: badgeTextColor,
                  ),
                ),
              ),

              // Platform Availability Badge
              Container(
                padding: const EdgeInsets.symmetric(horizontal: 5, vertical: 1.5),
                decoration: BoxDecoration(
                  color: isAvailable ? const Color(0x2510B981) : const Color(0x25EF4444),
                  borderRadius: BorderRadius.circular(4),
                  border: Border.all(
                    color: isAvailable
                        ? const Color(0xFF10B981).withValues(alpha: 0.5)
                        : const Color(0xFFEF4444).withValues(alpha: 0.5),
                  ),
                ),
                child: Row(
                  mainAxisSize: MainAxisSize.min,
                  children: [
                    Icon(
                      Icons.circle,
                      color: isAvailable ? const Color(0xFF10B981) : const Color(0xFFEF4444),
                      size: 5.5,
                    ),
                    const SizedBox(width: 3),
                    Text(
                      isAvailable ? 'In Stock' : 'Out of Stock',
                      style: TextStyle(
                        fontSize: 8.5,
                        fontWeight: FontWeight.bold,
                        color: isAvailable ? const Color(0xFF34D399) : const Color(0xFFF87171),
                      ),
                    ),
                  ],
                ),
              ),
            ],
          ),

          const SizedBox(height: 8),

          // Product Thumbnail
          Container(
            height: 72,
            width: 72,
            decoration: BoxDecoration(
              color: const Color(0xFF161E2B),
              borderRadius: BorderRadius.circular(8),
            ),
            child: (item != null && item.imageUrl.isNotEmpty)
                ? ClipRRect(
                    borderRadius: BorderRadius.circular(8),
                    child: Image.network(
                      item.imageUrl,
                      fit: BoxFit.contain,
                      errorBuilder: (context, error, stackTrace) => const Icon(
                        Icons.shopping_bag_outlined,
                        size: 26,
                        color: Color(0xFF64748B),
                      ),
                    ),
                  )
                : const Icon(
                    Icons.shopping_bag_outlined,
                    size: 26,
                    color: Color(0xFF64748B),
                  ),
          ),

          const SizedBox(height: 8),

          // Price Display
          if (isAvailable) ...[
            Wrap(
              alignment: WrapAlignment.center,
              crossAxisAlignment: WrapCrossAlignment.center,
              spacing: 4.0,
              runSpacing: 4.0,
              children: [
                Text(
                  '₹${item.price.toStringAsFixed(item.price.truncateToDouble() == item.price ? 0 : 2)}',
                  style: TextStyle(
                    fontSize: 16.5,
                    fontWeight: FontWeight.w900,
                    color: isCheapestPrice ? const Color(0xFF34D399) : Colors.white,
                  ),
                ),
                if (isCheapestPrice)
                  Container(
                    padding: const EdgeInsets.symmetric(horizontal: 4, vertical: 1),
                    decoration: BoxDecoration(
                      color: const Color(0xFF10B981),
                      borderRadius: BorderRadius.circular(3),
                    ),
                    child: const Text(
                      'CHEAPEST',
                      style: TextStyle(
                        fontSize: 7.0,
                        fontWeight: FontWeight.w900,
                        color: Colors.white,
                        letterSpacing: 0.3,
                      ),
                    ),
                  ),
              ],
            ),

            // Standard Unit Price Badge (highlighting cheaper platform in green)
            if (stdUnitPrice > 0 && stdUnit.isNotEmpty) ...[
              const SizedBox(height: 3),
              Container(
                padding: const EdgeInsets.symmetric(horizontal: 5, vertical: 1.5),
                decoration: BoxDecoration(
                  color: isCheapestUnit ? const Color(0x2510B981) : const Color(0xFF161E2B),
                  borderRadius: BorderRadius.circular(4),
                  border: Border.all(
                    color: isCheapestUnit
                        ? const Color(0xFF10B981).withValues(alpha: 0.6)
                        : const Color(0xFF222D3D),
                  ),
                ),
                child: Text(
                  '₹${stdUnitPrice.toStringAsFixed(2)} / $stdUnit',
                  style: TextStyle(
                    fontSize: 9.5,
                    fontWeight: isCheapestUnit ? FontWeight.bold : FontWeight.w500,
                    color: isCheapestUnit ? const Color(0xFF34D399) : const Color(0xFF94A3B8),
                  ),
                ),
              ),
            ] else if (item.formattedUnitPrice.isNotEmpty) ...[
              const SizedBox(height: 3),
              Text(
                item.formattedUnitPrice,
                style: const TextStyle(
                  fontSize: 9.5,
                  color: Color(0xFF94A3B8),
                ),
              ),
            ],
          ] else ...[
            const SizedBox(height: 6),
            const Text(
              'Unavailable',
              style: TextStyle(
                fontSize: 13,
                fontWeight: FontWeight.bold,
                color: Color(0xFFEF4444),
              ),
            ),
            const SizedBox(height: 2),
            const Text(
              'Out of stock at dark-store',
              textAlign: TextAlign.center,
              style: TextStyle(
                fontSize: 9,
                color: Color(0xFF64748B),
                fontStyle: FontStyle.italic,
              ),
            ),
          ],

          const SizedBox(height: 6),

          // Pack size
          Text(
            (item != null && item.packsize.isNotEmpty) ? item.packsize : '1 pack',
            maxLines: 1,
            overflow: TextOverflow.ellipsis,
            style: const TextStyle(
              fontSize: 10.5,
              color: Color(0xFFCBD5E1),
              fontWeight: FontWeight.w500,
            ),
          ),

          const Spacer(),
          const SizedBox(height: 8),

          // Buy Button / Disabled Button
          SizedBox(
            width: double.infinity,
            height: 32,
            child: !isAvailable
                ? OutlinedButton(
                    onPressed: null,
                    style: OutlinedButton.styleFrom(
                      side: const BorderSide(color: Color(0xFF1E293B)),
                      shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(8)),
                      padding: EdgeInsets.zero,
                    ),
                    child: const Text(
                      'Out of Stock',
                      style: TextStyle(
                        fontSize: 10.5,
                        color: Color(0xFF64748B),
                        fontWeight: FontWeight.w600,
                      ),
                    ),
                  )
                : ElevatedButton(
                    onPressed: () {
                      if (item.buyUrl.isNotEmpty) {
                        widget.onBuy(item.buyUrl);
                      }
                    },
                    style: ElevatedButton.styleFrom(
                      backgroundColor: brandColor,
                      foregroundColor: badgeTextColor,
                      shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(8)),
                      padding: EdgeInsets.zero,
                      elevation: 0,
                    ),
                    child: const Row(
                      mainAxisAlignment: MainAxisAlignment.center,
                      children: [
                        Icon(Icons.shopping_bag_outlined, size: 13),
                        SizedBox(width: 4),
                        Text(
                          'Buy',
                          style: TextStyle(fontSize: 11.5, fontWeight: FontWeight.bold),
                        ),
                      ],
                    ),
                  ),
          ),
        ],
      ),
    );
  }
}
