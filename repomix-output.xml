  Future<void> _injectLocationIntoInstamart() async {
    if (_latitude == null || _longitude == null) return;
    try {
      final lat = '$_latitude';
      final lon = '$_longitude';
      final cookieManager = WebViewCookieManager();
      const latKeys = ['user_latitude', 'lat', 'latitude', 'swiggy_lat'];
      const lonKeys = ['user_longitude', 'lng', 'lon', 'longitude', 'swiggy_lng'];

      for (final k in latKeys) {
        await cookieManager.setCookie(
          WebViewCookie(name: k, value: lat, domain: '.swiggy.com', path: '/'),
        );
      }
      for (final k in lonKeys) {
        await cookieManager.setCookie(
          WebViewCookie(name: k, value: lon, domain: '.swiggy.com', path: '/'),
        );
      }

      final script = '''
        (function() {
          try {
            const lat = '$lat';
            const lon = '$lon';
            localStorage.setItem('swiggy_lat', lat);
            localStorage.setItem('swiggy_lng', lon);
            localStorage.setItem('user_latitude', lat);
            localStorage.setItem('user_longitude', lon);
            localStorage.setItem('userLocation', JSON.stringify({ latitude: parseFloat(lat), longitude: parseFloat(lon), address: 'Current Location' }));
          } catch(e) {}
        })();
      ''';
      await _instamartWebViewController.runJavaScript(script);
      debugPrint('[Instamart Location Interceptor] Injected native coordinates into Instamart');
    } catch (e) {
      debugPrint('[Instamart Location Injection Error] $e');
    }
  }

