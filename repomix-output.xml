  Widget _build2ColProductCard(ProductComparisonItem item) {
    final hasBlinkit = item.blinkit != null;
    final hasZepto = item.zepto != null;
    final hasInstamart = item.instamart != null;
    final int storeCount = (hasBlinkit ? 1 : 0) + (hasZepto ? 1 : 0) + (hasInstamart ? 1 : 0);
    final bool hasMultiple = storeCount > 1;

    final bool isBlinkitCheaper = item.cheaperStore == 'Blinkit' && hasMultiple;
    final bool isZeptoCheaper = item.cheaperStore == 'Zepto' && hasMultiple;
    final bool isInstamartCheaper = item.cheaperStore == 'Instamart' && hasMultiple;
    final bool isEqual = item.cheaperStore == 'Equal' && hasMultiple;

    final String targetStore = hasBlinkit
        ? 'Blinkit'
        : (hasZepto ? 'Zepto' : (hasInstamart ? 'Instamart' : ''));
    final String targetUrl = hasBlinkit
        ? item.blinkit!.buyUrl
        : (hasZepto ? item.zepto!.buyUrl : (hasInstamart ? item.instamart!.buyUrl : ''));

    return Container(
      decoration: BoxDecoration(
        color: const Color(0xFF141C27),
        borderRadius: BorderRadius.circular(14),
        border: Border.all(color: const Color(0xFF222D3D)),
      ),
      clipBehavior: Clip.antiAlias,
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          // Top Image Container (Height 95 with dark background #161E2B)
          Container(
            height: 95,
            width: double.infinity,
            color: const Color(0xFF161E2B),
            child: Stack(
              alignment: Alignment.center,
              children: [
                Padding(
                  padding: const EdgeInsets.all(4),
                  child: item.imageUrl.isNotEmpty
                      ? Image.network(
                          item.imageUrl,
                          height: 75,
                          fit: BoxFit.contain,
                          errorBuilder: (context, error, stackTrace) => const Center(
                            child: Icon(Icons.shopping_bag_outlined, color: Color(0xFF64748B), size: 32),
                          ),
                        )
                      : const Center(
                          child: Icon(Icons.shopping_bag_outlined, color: Color(0xFF64748B), size: 32),
                        ),
                ),
                // Floating badge at bottom center: "Tap to Open" with #38BDF8 link icon
                Positioned(
                  bottom: 3,
                  child: InkWell(
                    onTap: () {
                      if (targetStore == 'Instamart') {
                        _openInstamart(item.name, targetUrl);
                      } else if (targetUrl.isNotEmpty) {
                        _openBuyLink(targetUrl);
                      }
                    },
                    borderRadius: BorderRadius.circular(12),
                    child: Container(
                      padding: const EdgeInsets.symmetric(horizontal: 7, vertical: 2),
                      decoration: BoxDecoration(
                        color: const Color(0xCC0C1017),
                        borderRadius: BorderRadius.circular(12),
                        border: Border.all(color: const Color(0xFF243142)),
                      ),
                      child: const Row(
                        mainAxisSize: MainAxisSize.min,
                        children: [
                          Icon(Icons.open_in_new_rounded, size: 9.5, color: Color(0xFF38BDF8)),
                          SizedBox(width: 3),
                          Text(
                            'Tap to Open',
                            style: TextStyle(
                              fontSize: 8.5,
                              color: Color(0xFF38BDF8),
                              fontWeight: FontWeight.bold,
                            ),
                          ),
                        ],
                      ),
                    ),
                  ),
                ),
              ],
            ),
          ),

          // Content Area
          Padding(
            padding: const EdgeInsets.symmetric(horizontal: 6, vertical: 5),
            child: Column(
              crossAxisAlignment: CrossAxisAlignment.start,
              children: [
                // Product Title (Bold white text, 2-line max with ellipsis)
                Text(
                  item.name,
                  maxLines: 2,
                  overflow: TextOverflow.ellipsis,
                  style: const TextStyle(
                    fontWeight: FontWeight.bold,
                    fontSize: 12,
                    color: Colors.white,
                    height: 1.15,
                  ),
                ),
                const SizedBox(height: 2),
                Text(
                  'Pack: ${item.packsize}',
                  maxLines: 1,
                  overflow: TextOverflow.ellipsis,
                  style: const TextStyle(
                    fontSize: 9.5,
                    color: Color(0xFF94A3B8),
                  ),
                ),

                const SizedBox(height: 5),

                // Stacked Store Rows (Blinkit, Zepto, Instamart)
                if (item.blinkit != null && item.blinkit!.price >= 10) ...[
                  _buildStoreRow(
                    storeName: 'Blinkit',
                    brandColor: const Color(0xFFF7C948),
                    textColor: Colors.black,
                    offer: item.blinkit,
                    isCheapest: isBlinkitCheaper,
                    isEqual: isEqual,
                    defaultUrl: 'https://blinkit.com/s/?q=${Uri.encodeComponent(item.name)}',
                  ),
                  if ((item.zepto != null && item.zepto!.price >= 10) || (item.instamart != null && item.instamart!.price >= 10))
