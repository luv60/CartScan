class _CompareHomePageState extends State<CompareHomePage> with WidgetsBindingObserver {
  final TextEditingController _searchController = TextEditingController(text: '');
  String _serverBaseUrl = 'http://127.0.0.1:8000';

  static String normalizeServerUrl(String input) {
    var s = input.trim();
    if (s.isEmpty) return 'http://127.0.0.1:8000';
    while (s.endsWith('/')) {
      s = s.substring(0, s.length - 1);
    }
    if (!s.startsWith('http://') && !s.startsWith('https://')) {
      s = 'http://$s';
    }
    final uri = Uri.tryParse(s);
    if (uri != null && uri.hasPort == false && !s.startsWith('https://')) {
      s = '$s:8000';
    }
    return s;
  }

  double? _latitude;
  double? _longitude;
  double? _lastKnownLat;
  double? _lastKnownLon;
  StreamSubscription<Position>? _positionStreamSub;
  String _locationStatus = 'Detecting GPS...';
  String _currentAddress = 'Detecting Location...';
  bool _isGpsActive = false;

  bool _isLoading = false;
  String? _errorMessage;
  List<CanonicalCard> _canonicalCards = [];
  List<ProductComparisonItem> _results = [];
  int _rawBlinkitCount = 0;
  int _rawZeptoCount = 0;
  int _rawInstamartCount = 0;
  int _bottomNavIndex = 0;

  late final WebViewController _instamartWebViewController;
  late final WebViewController _zeptoWebViewController;
  final bool _isHarvesterReady = true;
  bool _isInstamartReady = false;
  bool _isZeptoReady = false;
  String? _lastFetchedKey;
  bool _isZeptoServiceable = false;
  bool _zeptoStoreIdPresent = false;
  bool _browserGeolocationAvailable = false;
  bool _browserGeolocationSuccess = false;
  bool _serviceabilityRequestSeen = false;
  bool _serviceabilityAfterLocation = false;
  bool _locationRequestMatchesNative = false;
  double? _serviceabilityReqLat;
  double? _serviceabilityReqLon;
  String? _serviceabilityReqLatStr;
  String? _serviceabilityReqLonStr;
  String? _zeptoStoreId;
  String? _zeptoPincode;
  bool _zeptoBootstrapEstablished = false;

  int _determineCoordinatePrecision(String? rawStr, double value) {
    if (rawStr != null && rawStr.contains('.')) {
      final decimalPart = rawStr.split('.')[1].replaceAll(RegExp(r'[^\d]'), '');
      if (decimalPart.isNotEmpty) {
        return decimalPart.length;
      }
    }
    final s = value.toString();
    if (s.contains('.')) {
      final decimalPart = s.split('.')[1].replaceAll(RegExp(r'[^\d]'), '');
      if (decimalPart.isNotEmpty) {
        return decimalPart.length;
      }
    }
    return 4;
  }

  void _verifyServiceabilityLocationMatch() {
    if (_latitude == null ||
        _longitude == null ||
        _serviceabilityReqLat == null ||
        _serviceabilityReqLon == null) {
      _locationRequestMatchesNative = false;
      return;
    }

    final int latPrecision = _determineCoordinatePrecision(_serviceabilityReqLatStr, _serviceabilityReqLat!);
    final int lonPrecision = _determineCoordinatePrecision(_serviceabilityReqLonStr, _serviceabilityReqLon!);

    final String nativeLatFixed = _latitude!.toStringAsFixed(latPrecision);
    final String reqLatFixed = _serviceabilityReqLat!.toStringAsFixed(latPrecision);
    final String nativeLonFixed = _longitude!.toStringAsFixed(lonPrecision);
    final String reqLonFixed = _serviceabilityReqLon!.toStringAsFixed(lonPrecision);

    final bool latRoundMatch = nativeLatFixed == reqLatFixed;
    final bool lonRoundMatch = nativeLonFixed == reqLonFixed;

    final double latPrecisionUnit = math.pow(10, -latPrecision).toDouble();
    final double lonPrecisionUnit = math.pow(10, -lonPrecision).toDouble();
    final bool latDiffMatch = (_latitude! - _serviceabilityReqLat!).abs() <= latPrecisionUnit;
    final bool lonDiffMatch = (_longitude! - _serviceabilityReqLon!).abs() <= lonPrecisionUnit;

    _locationRequestMatchesNative = (latRoundMatch || latDiffMatch) && (lonRoundMatch || lonDiffMatch);
    debugPrint('[Zepto Location Match] native=($_latitude, $_longitude), req=($_serviceabilityReqLat, $_serviceabilityReqLon), prec=($latPrecision, $lonPrecision) => $_locationRequestMatchesNative');
  }

  bool get _isLocationBoundServiceabilityReady =>
      _zeptoBootstrapEstablished &&
      _isZeptoServiceable &&
      _zeptoStoreIdPresent &&
      _locationRequestMatchesNative;

  @override
  void initState() {
    super.initState();
    WidgetsBinding.instance.addObserver(this);
    final stateCtrl = SearchStateController();
    if (stateCtrl.serverBaseUrl.isNotEmpty) {
      _serverBaseUrl = stateCtrl.serverBaseUrl;
    }
    if (stateCtrl.hasSearched) {
      _searchController.text = stateCtrl.searchQuery;
      _canonicalCards = List.from(stateCtrl.canonicalCards);
      _results = List.from(stateCtrl.results);
      _rawBlinkitCount = stateCtrl.rawBlinkitCount;
      _rawZeptoCount = stateCtrl.rawZeptoCount;
      _rawInstamartCount = stateCtrl.rawInstamartCount;
      _bottomNavIndex = stateCtrl.bottomNavIndex;
      if (stateCtrl.latitude != null) _latitude = stateCtrl.latitude;
      if (stateCtrl.longitude != null) _longitude = stateCtrl.longitude;
      if (stateCtrl.currentAddress.isNotEmpty) _currentAddress = stateCtrl.currentAddress;
      _verifyServiceabilityLocationMatch();
    }
    _initInstamartWebViewController();
    _initZeptoWebViewController();
    _initLocationAndFetch();
  }

  @override
  void didChangeAppLifecycleState(AppLifecycleState state) {
    super.didChangeAppLifecycleState(state);
    if (state == AppLifecycleState.resumed) {
      final stateCtrl = SearchStateController();
      if (stateCtrl.hasSearched && _canonicalCards.isEmpty && stateCtrl.canonicalCards.isNotEmpty) {
        setState(() {
          _searchController.text = stateCtrl.searchQuery;
          _canonicalCards = List.from(stateCtrl.canonicalCards);
          _results = List.from(stateCtrl.results);
          _rawBlinkitCount = stateCtrl.rawBlinkitCount;
          _rawZeptoCount = stateCtrl.rawZeptoCount;
          _rawInstamartCount = stateCtrl.rawInstamartCount;
          _bottomNavIndex = stateCtrl.bottomNavIndex;
          if (stateCtrl.latitude != null) _latitude = stateCtrl.latitude;
          if (stateCtrl.longitude != null) _longitude = stateCtrl.longitude;
          if (stateCtrl.currentAddress.isNotEmpty) _currentAddress = stateCtrl.currentAddress;
        });
      }
    }
  }

  @override
  void dispose() {
    WidgetsBinding.instance.removeObserver(this);
    _positionStreamSub?.cancel();
    _searchController.dispose();
    super.dispose();
  }

  void _initInstamartWebViewController() {
    _instamartWebViewController = WebViewController(
      onPermissionRequest: (request) => request.grant(),
    )
      ..setJavaScriptMode(JavaScriptMode.unrestricted)
      ..setUserAgent(
        'Mozilla/5.0 (Linux; Android 10; Mobile) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Mobile Safari/537.36',
      )
      ..setNavigationDelegate(
        NavigationDelegate(
          onPageFinished: (String url) async {
            if (mounted) {
              setState(() {
                _isInstamartReady = true;
              });
            }
            debugPrint('[Instamart Browser] Page loaded: $url');
            _injectLocationIntoInstamart();
          },
        ),
      );

    if (_instamartWebViewController.platform is AndroidWebViewController) {
      final androidController = _instamartWebViewController.platform as AndroidWebViewController;
      androidController.setOnPlatformPermissionRequest((request) => request.grant());
      androidController.setGeolocationPermissionsPromptCallbacks(
        onShowPrompt: (request) async => const GeolocationPermissionsResponse(allow: true, retain: true),
      );
    }

    _instamartWebViewController.loadRequest(Uri.parse('https://www.swiggy.com/instamart'));
  }

  void _initZeptoWebViewController() async {
    _zeptoWebViewController = WebViewController(
      onPermissionRequest: (request) => request.grant(),
    )
      ..setJavaScriptMode(JavaScriptMode.unrestricted)
      ..setUserAgent(
  'Mozilla/5.0 (Linux; Android 10; Mobile) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Mobile Safari/537.36',
)
      
      ..setNavigationDelegate(
        NavigationDelegate(
          onPageStarted: (String url) {
            _injectEarlyInterceptor('onPageStarted');
          },
          onProgress: (int progress) {
            if (progress >= 15 && progress <= 60) {
              _injectEarlyInterceptor('progress_$progress');
            }
          },
          onWebResourceError: (WebResourceError error) {
            debugPrint('[Zepto WebView] ResourceError: code=${error.errorCode}, desc=${error.description}');
          },
          onPageFinished: (String url) async {
            if (mounted) {
              setState(() {
                _isZeptoReady = true;
              });
            }
            debugPrint('[Zepto WebView] Page finished loading: $url');
            _injectEarlyInterceptor('onPageFinished');

            try {
  final result =
      await _zeptoWebViewController.runJavaScriptReturningResult(
    "JSON.stringify({"
    "exists: typeof ZeptoBridge !== 'undefined',"
    "type: typeof ZeptoBridge,"
    "postMessage: typeof ZeptoBridge?.postMessage"
    "})",
  );

  debugPrint('[ZEPTO BRIDGE INSPECT] $result');
} catch (e) {
  debugPrint('[ZEPTO BRIDGE INSPECT ERROR] $e');
}
          },
        ),
      );

      await _zeptoWebViewController.addJavaScriptChannel(
  'ZeptoBridge',
  onMessageReceived: (JavaScriptMessage message) {
    debugPrint('[ZEPTO BRIDGE TEST] RECEIVED: ${message.message}');
    _handleZeptoMessage(message.message);
  },
);

    if (_zeptoWebViewController.platform is AndroidWebViewController) {
  final androidController =
      _zeptoWebViewController.platform as AndroidWebViewController;

  await androidController.setOnPlatformPermissionRequest(
    (request) => request.grant(),
  );

  await androidController.setGeolocationEnabled(true);

  await androidController.setGeolocationPermissionsPromptCallbacks(
    onShowPrompt: (request) async =>
        const GeolocationPermissionsResponse(
          allow: true,
          retain: true,
        ),
  );
}


    debugPrint('[Zepto WebView] Initiating load of https://www.zepto.com/');
    _zeptoWebViewController.loadRequest(Uri.parse('https://www.zepto.com/'));
  }

  Future<void> _injectEarlyInterceptor([String source = 'default']) async {
    final latVal = _latitude;
    final lonVal = _longitude;
    final String initialLocationJs = (latVal != null && lonVal != null)
        ? 'window.__nativeLocation = { lat: $latVal, lon: $lonVal };'
        : 'if (typeof window.__nativeLocation === "undefined") window.__nativeLocation = null;';

    final script = '''
(function() {
  $initialLocationJs
'''
        r'''
  if (window.__zeptoProductionInterceptorInstalled) return;
  window.__zeptoProductionInterceptorInstalled = true;
  window.__lastZeptoSearchPayload = null;

  try {
    const lsKeys = [];
    for (let i = 0; i < localStorage.length; i++) {
      const k = localStorage.key(i);
      lsKeys.push(k + '=' + String(localStorage.getItem(k)).slice(0, 100));
    }
    ZeptoBridge.postMessage(JSON.stringify({
      type: 'ZEPTO_STORAGE_DUMP',
      dump: lsKeys
    }));
  } catch(e) {}

  function makePosition(lat, lon) {
    return {
      coords: {
        latitude: lat,
        longitude: lon,
        accuracy: 15.0,
        altitude: null,
        altitudeAccuracy: null,
        heading: null,
        speed: null
      },
      timestamp: Date.now()
    };
  }

  if (navigator && navigator.geolocation) {
    try {
      ZeptoBridge.postMessage(JSON.stringify({
        type: 'ZEPTO_GEOLOCATION_STATUS',
        available: true
      }));
    } catch(e) {}
    const origGet = navigator.geolocation.getCurrentPosition;

    navigator.geolocation.getCurrentPosition = function(success, error, options) {
      function deliver() {
        if (window.__nativeLocation && typeof window.__nativeLocation.lat === 'number') {
          window.__zeptoBrowserLocationEstablished = true;
          try {
            ZeptoBridge.postMessage(JSON.stringify({
              type: 'ZEPTO_GEOLOCATION_STATUS',
              available: true,
              success: true
            }));
          } catch(e) {}
          if (typeof success === 'function') {
            success(makePosition(window.__nativeLocation.lat, window.__nativeLocation.lon));
          }
          return true;
        }
        return false;
      }

      if (deliver()) return;

      let elapsed = 0;
      const interval = setInterval(function() {
        elapsed += 100;
        if (deliver()) {
          clearInterval(interval);
        } else if (elapsed >= 5000) {
          clearInterval(interval);
          origGet.call(navigator.geolocation, function(pos) {
            window.__zeptoBrowserLocationEstablished = true;
            try {
              ZeptoBridge.postMessage(JSON.stringify({
                type: 'ZEPTO_GEOLOCATION_STATUS',
                available: true,
                success: true
              }));
            } catch(e) {}
            if (typeof success === 'function') success(pos);
          }, function(err) {
            try {
              ZeptoBridge.postMessage(JSON.stringify({
                type: 'ZEPTO_GEOLOCATION_STATUS',
                available: true,
                success: false
              }));
            } catch(e) {}
            if (typeof error === 'function') error(err);
          }, options);
        }
      }, 100);
    };

    if (navigator.geolocation.watchPosition) {
      navigator.geolocation.watchPosition = function(success, error, options) {
        if (window.__nativeLocation && typeof window.__nativeLocation.lat === 'number') {
          if (typeof success === 'function') {
            success(makePosition(window.__nativeLocation.lat, window.__nativeLocation.lon));
          }
        }
        return 1;
      };
    }
  }

  if (navigator && navigator.permissions && navigator.permissions.query) {
    try {
      const origPermQuery = navigator.permissions.query;
      navigator.permissions.query = function(param) {
        if (param && param.name === 'geolocation') {
          return Promise.resolve({ state: 'granted', onchange: null });
        }
        return origPermQuery.apply(this, arguments);
      };
    } catch(e) {}
  }

  function extractCoordsFromUrl(u) {
    if (!u || typeof u !== 'string') return null;
    try {
      const qIdx = u.indexOf('?');
      if (qIdx !== -1) {
        const query = u.substring(qIdx + 1);
        const pairs = query.split('&');
        let lat = null, lon = null;
        let latStr = null, lonStr = null;
        for (let i = 0; i < pairs.length; i++) {
          const p = pairs[i].split('=');
