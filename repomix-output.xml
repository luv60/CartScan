class CanonicalCard {
  final String id;
  final String canonicalName;
  final String cheapestStore;
  final double savings;
  final UnitPriceComparison? unitPriceComparison;
  final String brand;
  final String packaging;
  final double quantity;
  final String unit;
  final StoreItem? blinkit;
  final List<StoreItem> blinkitVariants;
  final StoreItem? zepto;
  final List<StoreItem> zeptoVariants;

  CanonicalCard({
    required this.id,
    required this.canonicalName,
    required this.cheapestStore,
    required this.savings,
    this.unitPriceComparison,
    this.brand = '',
    this.packaging = '',
    this.quantity = 0.0,
    this.unit = '',
    this.blinkit,
    this.blinkitVariants = const [],
    this.zepto,
    this.zeptoVariants = const [],
  });

  factory CanonicalCard.fromJson(Map<String, dynamic> json) {
    return CanonicalCard(
      id: json['id']?.toString() ?? '',
      canonicalName: json['canonical_name'] ?? json['name'] ?? '',
      cheapestStore: json['cheapest_store'] ?? '',
      savings: (json['savings'] as num?)?.toDouble() ?? 0.0,
      unitPriceComparison: json['unit_price_comparison'] != null
          ? UnitPriceComparison.fromJson(json['unit_price_comparison'])
          : null,
      brand: json['brand']?.toString() ?? '',
      packaging: json['packaging']?.toString() ?? '',
      quantity: (json['quantity'] as num?)?.toDouble() ?? 0.0,
      unit: json['unit']?.toString() ?? '',
      blinkit: json['blinkit'] != null ? StoreItem.fromJson(json['blinkit']) : null,
      blinkitVariants: (json['blinkit_variants'] as List?)
              ?.map((e) => StoreItem.fromJson(e))
              .toList() ??
          [],
      zepto: json['zepto'] != null ? StoreItem.fromJson(json['zepto']) : null,
      zeptoVariants: (json['zepto_variants'] as List?)
              ?.map((e) => StoreItem.fromJson(e))
              .toList() ??
          [],
    );
  }
}

class SearchStateController {
  static final SearchStateController _instance = SearchStateController._internal();
  factory SearchStateController() => _instance;
  SearchStateController._internal();

  String searchQuery = '';
  List<CanonicalCard> canonicalCards = [];
  List<ProductComparisonItem> results = [];
  int rawBlinkitCount = 0;
  int rawZeptoCount = 0;
  int rawInstamartCount = 0;
  bool hasSearched = false;
  double? latitude;
  double? longitude;
  String currentAddress = 'Detecting Location...';
  int bottomNavIndex = 0;
  String serverBaseUrl = 'http://127.0.0.1:8000';

  void saveSearch({
    required String query,
    required List<CanonicalCard> cards,
    required List<ProductComparisonItem> items,
    required int blinkitCount,
    required int zeptoCount,
    required int instamartCount,
    double? lat,
    double? lon,
    String? address,
    int? navIndex,
  }) {
    searchQuery = query;
    canonicalCards = List.from(cards);
    results = List.from(items);
    rawBlinkitCount = blinkitCount;
    rawZeptoCount = zeptoCount;
    rawInstamartCount = instamartCount;
    hasSearched = true;
    if (lat != null) latitude = lat;
    if (lon != null) longitude = lon;
    if (address != null && address.isNotEmpty) currentAddress = address;
    if (navIndex != null) bottomNavIndex = navIndex;
  }

  void clear() {
    searchQuery = '';
    canonicalCards = [];
    results = [];
    rawBlinkitCount = 0;
    rawZeptoCount = 0;
    rawInstamartCount = 0;
    hasSearched = false;
  }
}

class CompareHomePage extends StatefulWidget {
